FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN groupadd --gid 10001 erp && useradd --uid 10001 --gid 10001 --no-create-home erp
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt 'mcp>=1.12,<2' 'uvicorn>=0.30,<1'
COPY adapter /app/adapter
COPY mcp_server /app/mcp_server
RUN mkdir /state && chown 10001:10001 /state && chmod 0700 /state
USER 10001:10001
EXPOSE 8765 8766
